# Copy this file to ".env.local" and paste your Groq API key below.
# NOTE: no VITE_ prefix -> this value stays on the dev server and is NEVER
# bundled into the browser. The Vite proxy attaches it to requests server-side.
#
# Get a key at https://console.groq.com/keys
# If a key has ever been shared in plaintext (chat, email, screenshot), revoke
# it and generate a new one before using it here.
GROQ_API_KEY=

# Optional: override the default model.
# Good choices on Groq: llama-3.3-70b-versatile (default), openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile
